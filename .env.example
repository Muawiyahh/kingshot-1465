# Copy to .env.local and fill in from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only. Used to create player accounts. Never expose it to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Azure AI Translator (message translation). Create a resource at
# https://portal.azure.com/#create/Microsoft.CognitiveServicesTextTranslation
AZURE_TRANSLATOR_KEY=
# Only needed for a non-Global resource — the region shown on its "Keys and Endpoint" page,
# lowercased with no spaces (e.g. Central India -> centralindia). Leave empty for a Global resource.
AZURE_TRANSLATOR_REGION=
